{
  "name": "hasab-sdk",
  "version": "1.1.0",
  "description": "Hasab AI SDK for Node.js (chat, TTS, transcription, translation)",
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "module": "dist/client.js",
  "exports": {
    ".": {
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch"
  },
  "keywords": [
    "hasab",
    "sdk",
    "ai",
    "tts",
    "chat",
    "transcription",
    "translation"
  ],
  "author": "Eyob Simachew",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  }
}
